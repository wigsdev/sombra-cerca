---
import Layout from "../layouts/Layout.astro";
import CardEspacio from "../components/espacios/CardEspacio.astro";
import HeartIcon from "../assets/icons/heart.svg";
import { getAllSpaces } from "../data/espacios.js";

const espacios = getAllSpaces();
---

<Layout
  title="Mis favoritos · Sombra Cerca"
  description="Consulta y administra tus espacios urbanos guardados en Cajamarca."
>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-primary-500">
          Lista personal
        </p>
        <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-primary-900 sm:text-4xl">
          Espacios favoritos
        </h1>
        <p class="mt-2 text-base text-neutral-muted">
          Tus lugares guardados permanecen disponibles en este navegador para
          consultarlos rápidamente.
        </p>
      </div>
      <p
        id="contador-favoritos"
        aria-live="polite"
        class="text-sm font-semibold text-primary-700"
      >
        0 espacios guardados
      </p>
    </div>

    <!-- Cuadrícula de favoritos (solo muestra los guardados en localStorage) -->
    <div
      id="grid-favoritos"
      class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      {espacios.map((espacio) => (
        <CardEspacio espacio={espacio} />
      ))}
    </div>

    <!-- Estado vacío -->
    <div
      id="estado-favoritos-vacio"
      class="mt-10 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center"
    >
      <span
        class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-50 text-accent-amber"
        aria-hidden="true"
      >
        <HeartIcon class="h-7 w-7" aria-hidden="true" />
      </span>
      <h2 class="text-xl font-bold text-primary-900">
        Aún no tienes espacios guardados
      </h2>
      <p class="mx-auto mt-2 max-w-md text-sm text-neutral-muted">
        Explora los parques, plazas y alamedas de Cajamarca y pulsa “Guardar” en
        cualquier ficha o tarjeta para armar tu lista.
      </p>
      <a
        href="/espacios/"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-primary-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2"
      >
        Explorar espacios
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
