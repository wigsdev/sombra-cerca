---
import { formatDisponibilidad, formatNivel } from "../../data/espacios.js";
import CheckIcon from "../../assets/icons/check.svg";
import MinusIcon from "../../assets/icons/minus.svg";
import CloseIcon from "../../assets/icons/close.svg";
import HelpIcon from "../../assets/icons/help.svg";

interface Props {
  espacio: {
    sombra: string;
    asientos: boolean | null;
    agua: boolean | null;
    banos: boolean | null;
    rampas: boolean | null;
    iluminacion: string | null;
  };
}

const { espacio } = Astro.props;

type EstadoVisual = "positivo" | "medio" | "negativo" | "neutro";

interface Indicador {
  clave: string;
  etiqueta: string;
  valor: string;
  estado: EstadoVisual;
}

function estadoBooleano(valor: boolean | null): EstadoVisual {
  if (valor === true) return "positivo";
  if (valor === false) return "negativo";
  return "neutro";
}

function estadoNivel(valor: string | null): EstadoVisual {
  if (valor === "alta") return "positivo";
  if (valor === "media") return "medio";
  if (valor === "baja") return "negativo";
  return "neutro";
}

const indicadores: Indicador[] = [
  {
    clave: "sombra",
    etiqueta: "Nivel de sombra",
    valor: formatNivel(espacio.sombra),
    estado: estadoNivel(espacio.sombra),
  },
  {
    clave: "asientos",
    etiqueta: "Asientos / bancas",
    valor: formatDisponibilidad(espacio.asientos),
    estado: estadoBooleano(espacio.asientos),
  },
  {
    clave: "agua",
    etiqueta: "Agua potable",
    valor: formatDisponibilidad(espacio.agua),
    estado: estadoBooleano(espacio.agua),
  },
  {
    clave: "banos",
    etiqueta: "Baños públicos",
    valor: formatDisponibilidad(espacio.banos),
    estado: estadoBooleano(espacio.banos),
  },
  {
    clave: "rampas",
    etiqueta: "Rampas de acceso",
    valor: formatDisponibilidad(espacio.rampas),
    estado: estadoBooleano(espacio.rampas),
  },
  {
    clave: "iluminacion",
    etiqueta: "Iluminación nocturna",
    valor: formatNivel(espacio.iluminacion),
    estado: estadoNivel(espacio.iluminacion),
  },
];
---

<section aria-labelledby="heading-servicios" class="mt-10">
  <h2 id="heading-servicios" class="text-xl font-bold text-primary-900">
    Condiciones y servicios del espacio
  </h2>
  <p class="mt-1 text-sm text-neutral-muted">
    Cuando un servicio no cuenta con información confirmada, se indica
    explícitamente como “Sin información”.
  </p>

  <dl class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {indicadores.map((item) => (
      <div
        class:list={[
          "flex items-start gap-3.5 rounded-2xl border p-4",
          item.estado === "positivo" && "border-emerald-200 bg-emerald-50/70",
          item.estado === "medio" && "border-amber-200 bg-amber-50/70",
          item.estado === "negativo" && "border-orange-200 bg-orange-50/60",
          item.estado === "neutro" && "border-slate-200 bg-slate-50",
        ]}
      >
        <span
          aria-hidden="true"
          class:list={[
            "mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-xl text-sm font-bold",
            item.estado === "positivo" && "bg-primary-700 text-white",
            item.estado === "medio" && "bg-accent-amber text-white",
            item.estado === "negativo" && "bg-accent-terracota text-white",
            item.estado === "neutro" && "bg-slate-300 text-slate-800",
          ]}
        >
          {item.estado === "positivo" && <CheckIcon class="h-4 w-4" />}
          {item.estado === "medio" && <MinusIcon class="h-4 w-4" />}
          {item.estado === "negativo" && <CloseIcon class="h-4 w-4" />}
          {item.estado === "neutro" && <HelpIcon class="h-4 w-4" />}
        </span>

        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-muted">
            {item.etiqueta}
          </dt>
          <dd
            class:list={[
              "mt-0.5 text-base font-bold",
              item.estado === "positivo" && "text-primary-900",
              item.estado === "medio" && "text-amber-900",
              item.estado === "negativo" && "text-accent-terracota",
              item.estado === "neutro" && "text-slate-700",
            ]}
          >
            {item.valor}
          </dd>
        </div>
      </div>
    ))}
  </dl>
</section>
