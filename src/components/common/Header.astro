---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/espacios/", label: "Explorar espacios" },
  { href: "/favoritos/", label: "Favoritos", isFav: true },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-lg text-primary-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary-700 text-white shadow-sm"
        aria-hidden="true"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 22v-7m0 0c-3.5 0-6-2.5-6-6a6 6 0 1 1 12 0c0 3.5-2.5 6-6 6Z"
          />
        </svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-base font-extrabold tracking-tight text-primary-900">
          Sombra Cerca
        </span>
        <span class="text-xs text-neutral-muted">Cajamarca peatonal</span>
      </span>
    </a>

    <!-- Navegación escritorio -->
    <nav
      aria-label="Navegación principal"
      class="hidden items-center gap-1 sm:flex"
    >
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2",
              active
                ? "bg-primary-900 text-white"
                : "text-neutral-text hover:bg-emerald-50 hover:text-primary-700",
            ]}
          >
            <span>{link.label}</span>
            {link.isFav && (
              <span
                data-fav-count
                class:list={[
                  "hidden rounded-full px-2 py-0.5 text-xs font-bold",
                  active
                    ? "bg-white/20 text-white"
                    : "bg-emerald-100 text-primary-900",
                ]}
              >
                0
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Botón menú móvil -->
    <button
      type="button"
      id="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
      class="inline-flex items-center justify-center rounded-lg border border-slate-200 p-2 text-primary-900 hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2 sm:hidden"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>
  </div>

  <!-- Navegación móvil -->
  <nav
    id="mobile-menu"
    aria-label="Navegación móvil"
    class="hidden border-t border-slate-200 bg-white px-4 py-3 sm:hidden"
  >
    <div class="flex flex-col gap-1">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "flex items-center justify-between rounded-lg px-3.5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700",
              active
                ? "bg-primary-900 text-white"
                : "text-neutral-text hover:bg-emerald-50 hover:text-primary-700",
            ]}
          >
            <span>{link.label}</span>
            {link.isFav && (
              <span
                data-fav-count
                class:list={[
                  "hidden rounded-full px-2 py-0.5 text-xs font-bold",
                  active
                    ? "bg-white/20 text-white"
                    : "bg-emerald-100 text-primary-900",
                ]}
              >
                0
              </span>
            )}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden", isOpen);
      btn.setAttribute("aria-expanded", String(!isOpen));
      btn.setAttribute(
        "aria-label",
        isOpen ? "Abrir menú de navegación" : "Cerrar menú de navegación",
      );
    });
  }
</script>
